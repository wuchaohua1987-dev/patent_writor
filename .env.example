# Patent Writor Environment Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenAI API key for LLM operations
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Serper API key for web/patent search
# Get your key at https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Optional: Anthropic API key (alternative LLM provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration (optional)
# OPENAI_MODEL_NAME=gpt-4
# OPENAI_TEMPERATURE=0.7
